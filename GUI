    # -------------------------------
    # Get video information
    # -------------------------------

    def get_video_info(self):

        result = self.browser.RunScript(VIDEO_INFO_SCRIPT)

        if isinstance(result, tuple):
            success, result = result

            if not success:
                return None

        try:
            return json.loads(result)

        except (TypeError, ValueError):
            return None

    # -------------------------------
    # Flag button
    # -------------------------------

    def on_button_click(self, event):

        info = self.get_video_info()

        if info is None or not info["found"]:

            self.status.SetLabel("● Video unavailable")
            self.info_box.AppendText(
                "Could not retrieve video information.\n\n"
            )
            return

        timestamp = format_time(info["currentTime"])

        self.timestamp_label.SetLabel(timestamp)

        self.status.SetLabel("● Processing")

        self.info_box.AppendText(
            f"\nFlagged at {timestamp}\n"
            f"Generating explanation...\n\n"
        )

        try:
            transcript = extractTranscript(timestamp, 30)

            response = explain_maths(transcript)

            self.info_box.AppendText(response + "\n\n")

            self.status.SetLabel("● Ready")

        except Exception as error:

            self.info_box.AppendText(
                f"AI error: {error}\n\n"
            )

            self.status.SetLabel("● Error")

    # -------------------------------
    # Download transcript
    # -------------------------------

    def download_transcript(self, event):

        script = """
        let scripts = document.querySelectorAll(
            'script[type="module"]'
        );

        let captionsURL = null;

        for (let script of scripts) {

            let match = script.textContent.match(
                /const\\s+captions\\s*=\\s*["']([^"']+)["']/
            );

            if (match) {
                captionsURL = match[1];
                break;
            }
        }

        captionsURL;
        """

        result = self.browser.RunScript(script)

        if isinstance(result, tuple):
            success, url = result
            if not success:
                url = None
        else:
            url = result

        if not url or url == "null":

            self.info_box.AppendText(
                "Could not find transcript URL.\n"
            )
            return

        try:

            response = urllib.request.urlopen(url)

            transcript = response.read().decode("utf-8")

            with open(
                "lecture_transcript.vtt",
                "w",
                encoding="utf-8"
            ) as file:

                file.write(transcript)

            self.info_box.AppendText(
                "Transcript downloaded successfully!\n"
            )

            self.status.SetLabel("● Transcript downloaded")

        except Exception as error:

            self.info_box.AppendText(
                f"Download failed: {error}\n"
            )

            self.status.SetLabel("● Download failed")


